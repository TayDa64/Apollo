# =============================================================================
# Multimodal AI Music Generator (MUSE) - Git Ignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# Project-specific ignores
# =============================================================================

# Native build output
juce/build/

# Package build artifacts
packages/*/build/
packages/*/dist/
packages/*/*.egg-info/
packages/*/src/*.egg-info/

# Mutable agent/orchestration runtime state
.github/state/*.json

# Generated output artifacts (all runtime renders, diagnostics, logs)
output/
output_cli_golden*/
output_cli_golden_full/
output_cli_golden_short/
test_output_integration/

# Instrument analysis cache (regenerated on first run)
instruments/.instrument_cache.json
.instrument_cache.json

# Reference analysis cache
.reference_cache/

# User-added instruments (keep structure, ignore samples)
instruments/drums/kicks/*.wav
instruments/drums/kicks/*.WAV
instruments/drums/snares/*.wav
instruments/drums/snares/*.WAV
instruments/drums/hihats/*.wav
instruments/drums/hihats/*.WAV
instruments/drums/claps/*.wav
instruments/drums/claps/*.WAV
instruments/drums/808s/*.wav
instruments/drums/808s/*.WAV
instruments/bass/*.wav
instruments/bass/*.WAV
instruments/keys/*.wav
instruments/keys/*.WAV
instruments/synths/*.wav
instruments/synths/*.WAV
instruments/brass/*.wav
instruments/brass/*.WAV
instruments/strings/*.wav
instruments/strings/*.WAV
instruments/fx/*.wav
instruments/fx/*.WAV

# Keep the README in instruments
!instruments/README.md

# Temporary files
*.tmp
*.temp
*.log

# Development test scripts (local only)
audio_test.py
check_acceptance_criteria.py
verify_chord_extraction.py
.coverage

# SoundFont files (too large for repo)
*.sf2
*.SF2
*.sf3
*.SF3
*.sfz
*.SFZ

# Local neural model weights & llama.cpp runtime binaries
models/
*.gguf
tools/llama-cpp/

# Audio files (test outputs)
*.wav
*.mp3
*.aif
*.aiff
*.flac

# Exception: self-owned shippable hybrid attack-layer assets
!assets/attack_samples/**/*.wav

# Exception: never ignore checked-in test fixtures (JSON, MIDI, or audio)
!tests/fixtures/
!tests/fixtures/**
